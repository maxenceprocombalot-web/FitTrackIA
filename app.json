{
  "expo": {
    "name": "FitTrackIA",
    "slug": "fittrackia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "fittrackia",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fittrackia.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FitTrackIA utilise la caméra pour scanner les codes-barres des aliments.",
        "NSPhotoLibraryUsageDescription": "FitTrackIA accède à tes photos pour enregistrer tes photos de progression.",
        "NSFaceIDUsageDescription": "FitTrackIA utilise Face ID pour protéger l'accès à tes données d'entraînement.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A0A0B"
      },
      "package": "com.fittrackia.app",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E8B84B"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FitTrackIA utilise la caméra pour scanner les codes-barres des aliments."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitTrackIA accède à tes photos pour enregistrer tes photos de progression."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "FitTrackIA utilise Face ID pour protéger l'accès à tes données d'entraînement."
        }
      ],
      "expo-secure-store",
      [
        "expo-quick-actions",
        {
          "androidIcons": {},
          "iosActions": [
            {
              "id": "workout",
              "title": "Nouvelle séance",
              "subtitle": "Démarrer un entraînement",
              "icon": "symbol:figure.strengthtraining.traditional",
              "params": {
                "href": "/modals/add-workout"
              }
            },
            {
              "id": "food",
              "title": "Ajouter un repas",
              "subtitle": "Scanner ou rechercher",
              "icon": "symbol:fork.knife",
              "params": {
                "href": "/modals/add-food"
              }
            },
            {
              "id": "coach",
              "title": "Coach IA",
              "subtitle": "Poser une question",
              "icon": "symbol:sparkles",
              "params": {
                "href": "/(tabs)/coach"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "maxsas07",
    "extra": {
      "eas": {
        "projectId": "15e4e073-c2e8-4496-8cbb-bad08ae4f3f1"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/15e4e073-c2e8-4496-8cbb-bad08ae4f3f1"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}